# Copy to terraform.tfvars (gitignored) and edit.
# Confirm account first:
#   aws sts get-caller-identity --profile tow

aws_profile           = "tow"
aws_region            = "us-east-2"
expected_account_id   = "818904800844"
require_town_account  = true
name_prefix           = "tow-suite"
environment           = "prod"

# Cost kill-switch (required when enable_budgets = true)
enable_budgets      = true
budget_limit_usd    = "80"
budget_hard_limit_usd = "100"
budget_alert_emails = ["you@example.com"]

# Cheap deployable pieces for Widget + Apartments shared-contracts
enable_contracts_bucket = true
enable_ecr              = true
enable_publisher_user   = false

# Clerk databases stay on the Synology (Tailscale). Empty string skips the SSM parameter.
nas_apartments_url = "http://mr-storage:8082"
nas_tikr_url       = "http://mr-storage:8080"

# Leave empty while Widget compute stays off this account.
# widget_reference_data_url = ""

contracts_lifecycle_days = 30
ecr_image_count_limit    = 10
