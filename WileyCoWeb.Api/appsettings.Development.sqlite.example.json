{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=%LOCALAPPDATA%\\WileyWidget\\wiley-widget.db"
  },
  "Database": {
    "Provider": "SQLite",
    "SqliteDataPath": "%LOCALAPPDATA%\\WileyWidget\\wiley-widget.db",
    "AllowDegradedStartup": true,
    "SeedDevelopmentData": true,
    "EnsureWorkspacePanelBudgetWhenEmpty": true,
    "SkipQuickBooksSchemaGuard": false
  },
  "XAI": {
    "Enabled": true,
    "ApiKey": "",
    "ModelId": "grok-3-latest",
    "ChatEndpoint": "https://api.x.ai/v1",
    "Endpoint": "https://api.x.ai/v1",
    "TimeoutSeconds": 45
  },
  "WorkspacePanels": {
    "Fallback": {
      "UseSyntheticCapitalGapWhenNoBudgetData": true,
      "UseSyntheticDebtCoverageWhenEnterpriseMissing": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "WileyWidget": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%\\WileyWidget\\Logs\\wiley-widget-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
