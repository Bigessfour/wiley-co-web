{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=wileyco_dev;Username=postgres;Password=password"
  },
  "XAI": {
    "Enabled": true,
    "ChatEndpoint": "https://api.x.ai/v1",
    "Endpoint": "https://api.x.ai/v1",
    "TimeoutSeconds": 45,
    // Explicitly clear production AWS secret/parameter names for local dev.
    // This prevents SecretResolver from attempting SSM Parameter Store or Secrets Manager
    // calls when no AWS credentials are present. Local dev should use XAI_API_KEY env var,
    // user secrets, or appsettings.Development.local.json instead.
    "SecretName": null,
    "ParameterName": null
  },
  "Database": {
    "AllowDegradedStartup": true,
    "SeedDevelopmentData": true,
    "EnsureWorkspacePanelBudgetWhenEmpty": true
  },
  "WorkspacePanels": {
    "Fallback": {
      "UseSyntheticCapitalGapWhenNoBudgetData": true,
      "UseSyntheticDebtCoverageWhenEnterpriseMissing": true
    }
  },
  "WorkspaceReferenceData": {
    "RequireExplicitImportDataPath": false,
    "DefaultImportDataPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore.Database.Connection": "Information",
      "Microsoft.EntityFrameworkCore.Database.Transaction": "Information",
      "Microsoft.EntityFrameworkCore.Migrations": "Information",
      "WileyWidget": "Debug",
      "WileyWidget.Data": "Debug",
      "WileyWidget.Services": "Debug",
      "WileyWidget.Business": "Debug",
      "WileyCoWeb.Api": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
