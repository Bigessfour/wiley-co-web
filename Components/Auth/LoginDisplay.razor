@using Microsoft.AspNetCore.Components.Authorization
@using WileyCoWeb.Services.Auth
@inject StaffAuthCoordinator StaffAuth
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <div class="app-shell-auth" aria-label="Signed-in staff account">
            <span class="app-shell-auth-user">@context.User.Identity?.Name</span>
            @if (StaffAuth.IsEnabled)
            {
                <button id="app-shell-sign-out"
                        type="button"
                        class="e-control e-btn e-lib e-inherit app-shell-sign-out"
                        @onclick="SignOutAsync">
                    Sign out
                </button>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        @if (StaffAuth.IsEnabled)
        {
            <a id="app-shell-sign-in"
               class="e-control e-btn e-lib e-inherit app-shell-sign-in no-underline"
               href="@(StaffAuth.UsesHostedUi ? "/authentication/login" : "/authentication/legacy-login")">
                Sign in
            </a>
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task SignOutAsync()
    {
        await StaffAuth.SignOutAsync().ConfigureAwait(false);
        if (!StaffAuth.UsesHostedUi && AuthStateProvider is CognitoAuthenticationStateProvider cognitoAuthStateProvider)
        {
            cognitoAuthStateProvider.NotifyAuthenticationStateChanged();
            Navigation.NavigateTo("/authentication/legacy-login", forceLoad: false);
        }
    }
}
