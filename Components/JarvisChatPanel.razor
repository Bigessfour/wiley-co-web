@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.InteractiveChat
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Spinner

<div id="jarvis-chat-panel" class="jarvis-chat-panel @(ChatFirstLayout ? "jarvis-decision-support-layout" : "jarvis-rail-layout") flex min-h-0 flex-1 flex-col gap-2">
    @if (ChatFirstLayout)
    {
        <section id="jarvis-executive-band" class="jarvis-executive-band grid shrink-0 gap-2 md:grid-cols-2">
            <SfCard ID="jarvis-operational-status-card" CssClass="wiley-panel-card jarvis-summary-card min-w-0">
                <CardHeader Title="Operational status" SubTitle="@StatusText" />
                <CardContent Content="Workspace metrics, recommendations, and Jarvis chat all update from the same current snapshot." />
            </SfCard>

            <SfCard ID="jarvis-primary-brief-card" CssClass="wiley-panel-card jarvis-summary-card min-w-0">
                <CardHeader Title="Current brief" SubTitle="Live workspace summary" />
                <CardContent>
                    <div class="text-sm leading-5 wiley-text-muted">@PrimaryBrief</div>
                </CardContent>
            </SfCard>
        </section>

        @if (Insights.Count > 0)
        {
            <section id="jarvis-insights-band" class="jarvis-insights-band grid shrink-0 gap-2 grid-cols-2 xl:grid-cols-4">
                @foreach (var insight in Insights)
                {
                    <SfCard CssClass="wiley-panel-card jarvis-insight-card min-w-0">
                        <CardHeader Title="@insight.Label" SubTitle="@insight.Value" />
                        <CardContent>
                            <div class="text-xs leading-4 wiley-text-muted">@insight.Description</div>
                        </CardContent>
                    </SfCard>
                }
            </section>
        }

        <SfCard ID="jarvis-recommended-actions-card" CssClass="wiley-panel-card jarvis-actions-card shrink-0 min-w-0">
            <CardHeader Title="Recommended actions" SubTitle="@KnowledgeStatus" />
            <CardContent>
                <div class="jarvis-actions-toolbar flex items-center gap-2 pb-2">
                    <div class="wiley-panel-spinner-host jarvis-inline-spinner">
                        <SfSpinner Visible="@IsKnowledgeBusy" Size="18" Label="" Type="SpinnerType.Material" />
                    </div>
                    <SfTooltip Content="Refresh the live knowledge response that drives the executive brief, insights, and action recommendations."
                               Position="Syncfusion.Blazor.Popups.Position.TopCenter"
                               OpensOn="Hover Focus"
                               ShowTipPointer="true"
                               CloseDelay="200">
                        <SfButton CssClass="e-flat"
                                  Disabled="@IsKnowledgeBusy"
                                  OnClick="RefreshKnowledgeFromButtonAsync">Refresh</SfButton>
                    </SfTooltip>
                </div>

                <div class="jarvis-actions-scroll">
                    @if (RecommendedActions.Count == 0)
                    {
                        <div class="text-sm wiley-text-muted">No recommended actions yet for this workspace scope.</div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var action in RecommendedActions)
                            {
                                <div class="jarvis-action-item rounded-lg border border-[var(--wiley-border)] px-3 py-2">
                                    <div class="text-sm font-semibold wiley-text-muted">@action.Title</div>
                                    <div class="mt-1 text-sm leading-5 wiley-text-muted">@action.Description</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </CardContent>
        </SfCard>
    }

    @if (IsSecureJarvisEnabled)
    {
        <section id="jarvis-chat-stage" class="jarvis-chat-stage flex min-h-0 flex-1 flex-col gap-2">
            @if (ShowXaiKeySetupPrompt)
            {
                <SfCard ID="jarvis-xai-key-setup" CssClass="wiley-panel-card jarvis-xai-key-compact shrink-0 min-w-0">
                    <CardHeader Title="Add or rotate your xAI API key?" SubTitle="Local development convenience" />
                    <CardContent>
                        <div class="space-y-2">
                            <div class="text-sm wiley-text-muted">Jarvis is in fallback mode because no xAI key was found for the backend.</div>
                            <div class="flex flex-wrap gap-2">
                                <SfButton CssClass="e-success" Disabled="@IsSettingXaiKey" OnClick="OnXaiKeyPromptYes">Yes, add key</SfButton>
                                <SfButton CssClass="e-flat" Disabled="@IsSettingXaiKey" OnClick="OnXaiKeyPromptNo">Not now</SfButton>
                            </div>
                            @if (ShowXaiKeyInputForm)
                            {
                                <div class="grid gap-2 md:grid-cols-[1fr_auto] md:items-end">
                                    <SfTextBox @bind-Value="XaiKeyInput"
                                               Type="InputType.Password"
                                               Placeholder="sk-..."
                                               FloatLabelType="FloatLabelType.Auto"
                                               Width="100%"
                                               Enabled="!IsSettingXaiKey" />
                                    <SfButton CssClass="e-primary" Disabled="@(!CanSubmitXaiKey)" OnClick="SubmitXaiKeyAsync">
                                        @(IsSettingXaiKey ? "Saving..." : "Save key")
                                    </SfButton>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(XaiKeySetupMessage))
                            {
                                <div class="text-xs wiley-text-muted">@XaiKeySetupMessage</div>
                            }
                        </div>
                    </CardContent>
                </SfCard>
            }

            <SfCard ID="jarvis-runtime-status" CssClass="wiley-panel-card jarvis-runtime-card shrink-0 min-w-0">
                <CardHeader Title="@ChatRuntimeStatusTitle" SubTitle="Jarvis runtime" />
                <CardContent>
                    <div class="flex flex-wrap items-start justify-between gap-3" role="status" aria-live="polite" aria-busy="@IsChatBusy">
                        <div class="flex min-w-0 items-start gap-2">
                            <div class="wiley-panel-spinner-host jarvis-inline-spinner">
                                <SfSpinner Visible="@IsChatBusy" Size="18" Label="" Type="SpinnerType.Material" />
                            </div>
                            <div class="space-y-1">
                                <div class="text-sm leading-5 wiley-text-muted">@ChatRuntimeStatusDetail</div>
                                <div class="text-xs wiley-text-muted">Turn count: @ChatTranscript.Count · @CurrentConversationLabel</div>
                                <div class="text-xs wiley-text-muted">Profile summary: @CurrentProfileSummary</div>
                            </div>
                        </div>

                        <div class="flex flex-wrap items-center gap-2">
                            <span class="e-badge e-badge-info">@CurrentUserLabel</span>
                            @if (!ShowXaiKeySetupPrompt)
                            {
                                <SfButton CssClass="e-flat e-small" OnClick="@(() => DevKeyManagerExpanded = !DevKeyManagerExpanded)">
                                    @(DevKeyManagerExpanded ? "Hide dev key" : "Dev key")
                                </SfButton>
                            }
                        </div>
                    </div>
                </CardContent>
            </SfCard>

            @if (ShowDevKeyManager)
            {
                <SfCard ID="jarvis-dev-key-manager" CssClass="wiley-panel-card jarvis-xai-key-compact shrink-0 min-w-0">
                    <CardHeader Title="Dev: xAI Key" SubTitle="Local only — never commit keys" />
                    <CardContent>
                        <div class="grid gap-2 md:grid-cols-[1fr_auto] md:items-end">
                            <SfTextBox @bind-Value="XaiKeyInput"
                                       Type="InputType.Password"
                                       Placeholder="sk-..."
                                       FloatLabelType="FloatLabelType.Auto"
                                       Width="100%"
                                       Enabled="!IsSettingXaiKey" />
                            <SfButton CssClass="e-primary e-small" Disabled="@(!CanSubmitXaiKey)" OnClick="SubmitXaiKeyAsync">
                                @(IsSettingXaiKey ? "Saving..." : "Save / rotate")
                            </SfButton>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(XaiKeySetupMessage))
                        {
                            <div class="mt-2 text-xs wiley-text-muted">@XaiKeySetupMessage</div>
                        }
                    </CardContent>
                </SfCard>
            }

            <div class="jarvis-assist-host min-h-0 flex-1">
                <SfAIAssistView ID="@AssistViewId"
                                @ref="JarvisAssistView"
                                CssClass="jarvis-chat-surface min-h-0 w-full"
                                Height="100%"
                                Width="100%"
                                @bind-Prompt="ChatQuestion"
                                PromptPlaceholder="Ask about the workspace, codebase, or AI tools"
                                PromptRequested="OnPromptRequestedAsync"
                                Prompts="ChatPrompts"
                                PromptSuggestions="PromptSuggestions"
                                PromptSuggestionsHeader="Workspace prompts">
                    <ChildContent>
                        <AssistViewToolbar ItemClicked="OnAssistToolbarItemClicked">
                            <AssistViewToolbarItem Text="Refresh Guidance"
                                                   IconCss="e-icons e-refresh"
                                                   Tooltip="Refresh the live workspace knowledge response without leaving the Jarvis rail." />
                            <AssistViewToolbarItem Text="Reload History"
                                                   IconCss="e-icons e-clock"
                                                   Tooltip="Reload recommendation history for the current workspace scope." />
                        </AssistViewToolbar>
                        <AssistViews>
                            <AssistView Header="JARVIS" IconCss="e-icons e-ai-chat" ShowClearButton="true">
                                <BannerTemplate>
                                    <div class="space-y-1">
                                        <div class="text-sm leading-5 wiley-text-muted">@ChatContextSummary</div>
                                        <div class="text-xs wiley-text-muted">Profile summary: @CurrentProfileSummary</div>
                                    </div>
                                </BannerTemplate>

                                <PromptItemTemplate>
                                    <div class="jarvis-transcript-line text-sm wiley-text-muted">
                                        <span class="font-semibold">You:</span>
                                        <span class="whitespace-pre-line">@context.Prompt</span>
                                    </div>
                                </PromptItemTemplate>

                                <ResponseItemTemplate>
                                    <div class="jarvis-transcript-line text-sm leading-5 wiley-text-muted">
                                        <span class="font-semibold">Jarvis:</span>
                                        <span class="whitespace-pre-line">@context.Response</span>
                                    </div>
                                </ResponseItemTemplate>

                                <FooterTemplate>
                                    <div class="jarvis-chat-footer space-y-2">
                                        <SfTextBox ID="jarvis-question-input"
                                                   Placeholder="Ask about the workspace, codebase, or AI tools"
                                                   FloatLabelType="FloatLabelType.Auto"
                                                   Multiline="true"
                                                   Rows="2"
                                                   ShowClearButton="true"
                                                   MaxLength="4000"
                                                   Width="100%"
                                                   @bind-Value="ChatQuestion" />

                                        <div class="flex flex-wrap gap-2">
                                            <SfButton CssClass="e-primary"
                                                      IsPrimary="true"
                                                      Disabled="@(!CanAskChat)"
                                                      OnClick="SubmitFooterPromptAsync">Ask Jarvis</SfButton>
                                            <SfButton Disabled="@IsChatBusy"
                                                      OnClick="ResetChatAsync">Reset Thread</SfButton>
                                            <SfButton CssClass="e-flat"
                                                      Disabled="@IsKnowledgeBusy"
                                                      OnClick="RefreshKnowledgeFromButtonAsync">Refresh Context</SfButton>
                                        </div>
                                    </div>
                                </FooterTemplate>
                            </AssistView>
                        </AssistViews>
                    </ChildContent>
                </SfAIAssistView>
            </div>

            @if (ChatFirstLayout)
            {
                <div class="jarvis-audit-strip grid shrink-0 gap-2 md:grid-cols-3">
                    <SfCard ID="jarvis-conversation-history" CssClass="wiley-panel-card jarvis-audit-card min-w-0">
                        <CardHeader Title="Conversation history" SubTitle="@CurrentConversationLabel" />
                        <CardContent>
                            <div class="jarvis-audit-scroll">
                                @if (ChatTranscript.Count == 0)
                                {
                                    <div class="text-sm wiley-text-muted">No prior Jarvis turns yet.</div>
                                }
                                else
                                {
                                    @foreach (var message in ChatTranscript)
                                    {
                                        <div class="mb-2 text-sm wiley-text-muted">
                                            <span class="font-semibold">@(IsAssistantMessage(message.Role) ? "Jarvis" : "You"):</span>
                                            <span class="whitespace-pre-line">@message.Content</span>
                                        </div>
                                    }
                                }
                            </div>
                        </CardContent>
                    </SfCard>

                    <SfCard ID="jarvis-recommendation-history" CssClass="wiley-panel-card jarvis-audit-card min-w-0">
                        <CardHeader Title="Recommendation history" SubTitle="@RecommendationHistoryStatus" />
                        <CardContent>
                            <div class="jarvis-audit-scroll">
                                @if (RecommendationHistory.Count == 0)
                                {
                                    <div class="text-sm wiley-text-muted">No saved recommendations yet for this workspace scope.</div>
                                }
                                else
                                {
                                    @foreach (var entry in RecommendationHistory)
                                    {
                                        <div class="mb-2 text-sm wiley-text-muted">
                                            <div class="text-xs font-semibold">@entry.UserDisplayName · @FormatRecommendationTimestamp(entry.CreatedAtUtc)</div>
                                            <div class="whitespace-pre-line">@entry.Recommendation</div>
                                        </div>
                                    }
                                }
                            </div>
                        </CardContent>
                    </SfCard>

                    <SfCard ID="jarvis-chat-answer" CssClass="wiley-panel-card jarvis-audit-card min-w-0">
                        <CardHeader Title="Latest answer" SubTitle="Current workspace context" />
                        <CardContent>
                            <div class="jarvis-audit-scroll" role="status" aria-live="polite" aria-busy="@IsChatBusy">
                                <div class="text-xs wiley-text-muted">@ChatContextSummary</div>
                                <div class="mt-1 whitespace-pre-line text-sm leading-5 wiley-text-muted">@ChatAnswer</div>
                            </div>
                        </CardContent>
                    </SfCard>
                </div>
            }
            else
            {
                <SfCard ID="jarvis-conversation-history" CssClass="wiley-panel-card jarvis-audit-card shrink-0 min-w-0">
                    <CardHeader Title="Conversation history" SubTitle="@($"Jarvis chat · {CurrentConversationLabel}")" />
                    <CardContent>
                        <div class="jarvis-audit-scroll">
                            @if (ChatTranscript.Count == 0)
                            {
                                <div class="text-sm wiley-text-muted">No prior Jarvis turns yet.</div>
                            }
                            else
                            {
                                @foreach (var message in ChatTranscript)
                                {
                                    <div class="mb-2 text-sm wiley-text-muted">
                                        <span class="font-semibold">@(IsAssistantMessage(message.Role) ? "Jarvis" : "You"):</span>
                                        <span class="whitespace-pre-line">@message.Content</span>
                                    </div>
                                }
                            }
                        </div>
                    </CardContent>
                </SfCard>

                <SfCard ID="jarvis-recommendation-history" CssClass="wiley-panel-card jarvis-audit-card shrink-0 min-w-0">
                    <CardHeader Title="Recommendation history" SubTitle="@RecommendationHistoryStatus" />
                    <CardContent>
                        <div class="jarvis-audit-scroll">
                            @if (RecommendationHistory.Count == 0)
                            {
                                <div class="text-sm wiley-text-muted">No saved recommendations yet for this workspace scope.</div>
                            }
                            else
                            {
                                @foreach (var entry in RecommendationHistory)
                                {
                                    <div class="mb-2 text-sm wiley-text-muted">
                                        <div class="text-xs font-semibold">@entry.UserDisplayName · @FormatRecommendationTimestamp(entry.CreatedAtUtc)</div>
                                        <div class="whitespace-pre-line">@entry.Recommendation</div>
                                    </div>
                                }
                            }
                        </div>
                    </CardContent>
                </SfCard>

                <SfCard ID="jarvis-chat-answer" CssClass="wiley-panel-card jarvis-audit-card shrink-0 min-w-0">
                    <CardHeader Title="Latest answer" SubTitle="Current workspace context" />
                    <CardContent>
                        <div class="jarvis-audit-scroll" role="status" aria-live="polite" aria-busy="@IsChatBusy">
                            <div class="whitespace-pre-line text-sm leading-5 wiley-text-muted">@ChatAnswer</div>
                        </div>
                    </CardContent>
                </SfCard>
            }
        </section>
    }
    else
    {
        <SfCard CssClass="wiley-panel-card">
            <CardHeader Title="Delivery note" SubTitle="Secure Jarvis is disabled for this host." />
            <CardContent Content="This panel uses the same workspace state the rest of the UI reads and can call the server-side Semantic Kernel assistant when the xAI key is configured." />
        </SfCard>
    }
</div>
