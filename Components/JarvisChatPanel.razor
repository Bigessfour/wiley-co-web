@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.InteractiveChat
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Spinner

<div class="jarvis-chat-panel">
    <SfCard ID="jarvis-chat-shell-card" CssClass="h-full">
        <CardHeader Title="Decision Support" SubTitle="Live workspace guidance with a premium Jarvis AI rail." />
        <CardContent>
            <div class="flex flex-col gap-4">
                @* Removed: the flat operational-status pill and plain brief container.
                   Replacement: Syncfusion cards turn the executive state and workspace brief into first-class rail surfaces that resize cleanly inside the parent splitter. *@
                <div class="grid gap-4 xl:grid-cols-[0.85fr_1.15fr] @(ChatFirstLayout ? "order-2" : "order-1")">
                    <SfCard ID="jarvis-operational-status-card">
                        <CardHeader Title="Operational status" SubTitle="@StatusText" />
                        <CardContent>
                            <div class="text-sm wiley-text-muted">Workspace metrics, recommendations, and Jarvis chat all update from the same current snapshot.</div>
                        </CardContent>
                    </SfCard>

                    <SfCard ID="jarvis-primary-brief-card">
                        <CardHeader Title="Current brief" SubTitle="Live workspace summary" />
                        <CardContent>
                            <div class="text-sm leading-6 wiley-text-muted">@PrimaryBrief</div>
                        </CardContent>
                    </SfCard>
                </div>

                @* Removed: ad-hoc insight div tiles.
                   Replacement: every insight now renders as a nested Syncfusion card so the rail keeps a consistent visual language with the rest of the workspace shell. *@
                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4 @(ChatFirstLayout ? "order-4" : "order-2")">
                    @foreach (var insight in Insights)
                    {
                        <SfCard>
                            <CardHeader Title="@insight.Label" SubTitle="Decision-support metric" />
                            <CardContent>
                                <div class="text-2xl font-semibold wiley-text-muted">@insight.Value</div>
                                <div class="mt-2 text-sm leading-5 wiley-text-muted">@insight.Description</div>
                            </CardContent>
                        </SfCard>
                    }
                </div>

                @* Removed: custom recommendation shells.
                   Replacement: a Syncfusion recommendation workbench card keeps live-refresh actions, status, and action items in one component-native section. *@
                <SfCard ID="jarvis-recommended-actions-card" CssClass="@(ChatFirstLayout ? "order-5" : "order-3")">
                    <CardHeader Title="Recommended actions" SubTitle="@KnowledgeStatus" />
                    <CardContent>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between gap-3">
                                <div class="flex items-center gap-3">
                                    <div class="wiley-panel-spinner-host" style="height:20px;width:20px;">
                                        <SfSpinner Visible="@IsKnowledgeBusy" Size="18" Label="" Type="SpinnerType.Material" />
                                    </div>
                                    <div class="text-sm wiley-text-muted">Refresh live workspace knowledge and recommendation cards without leaving the rail.</div>
                                </div>

                                <SfTooltip Content="Refresh the live knowledge response that drives the executive brief, insights, and action recommendations."
                                           Position="Syncfusion.Blazor.Popups.Position.TopCenter"
                                           OpensOn="Hover Focus"
                                           ShowTipPointer="true"
                                           CloseDelay="200">
                                    <SfButton CssClass="e-flat"
                                              Disabled="@IsKnowledgeBusy"
                                              OnClick="RefreshKnowledgeFromButtonAsync">Refresh</SfButton>
                                </SfTooltip>
                            </div>

                            @foreach (var action in RecommendedActions)
                            {
                                <SfCard>
                                    <CardHeader Title="@action.Title" SubTitle="Recommended next step" />
                                    <CardContent>
                                        <div class="text-sm leading-5 wiley-text-muted">@action.Description</div>
                                    </CardContent>
                                </SfCard>
                            }
                        </div>
                    </CardContent>
                </SfCard>

                @if (IsSecureJarvisEnabled)
                {
                    <SfCard ID="jarvis-ai-rail-card" CssClass="@(ChatFirstLayout ? "order-1" : "order-4")">
                        <CardHeader Title="Jarvis chat" SubTitle="Secure API-backed assistant using the same workspace snapshot as the rest of the shell." />
                        <CardContent>
                            <div class="space-y-4">
                                @* Removed: the manual runtime banner div and CSS-only busy treatment.
                                   Replacement: a Syncfusion status card pairs runtime state, signed-in identity, scope, and a component-native spinner. *@
                                <SfCard ID="jarvis-runtime-status">
                                    <CardHeader Title="@ChatRuntimeStatusTitle"
                                                SubTitle="Jarvis runtime" />
                                    <CardContent>
                                        <div class="flex flex-wrap items-start justify-between gap-4" role="status" aria-live="polite" aria-busy="@IsChatBusy">
                                            <div class="flex items-start gap-3">
                                                <div class="wiley-panel-spinner-host" style="height:20px;width:20px;">
                                                    <SfSpinner Visible="@IsChatBusy" Size="18" Label="" Type="SpinnerType.Material" />
                                                </div>
                                                <div class="space-y-2">
                                                    <div class="text-sm leading-5 wiley-text-muted">@ChatRuntimeStatusDetail</div>
                                                    <div class="text-xs wiley-text-muted">Turn count: @ChatTranscript.Count</div>
                                                    <div class="text-xs wiley-text-muted">Profile summary: @CurrentProfileSummary</div>
                                                </div>
                                            </div>

                                            <div class="flex flex-wrap gap-2">
                                                <SfTooltip Content="Current signed-in identity resolved by the Jarvis user-context plugin."
                                                           Position="Syncfusion.Blazor.Popups.Position.TopCenter"
                                                           OpensOn="Hover Focus"
                                                           ShowTipPointer="true"
                                                           CloseDelay="200">
                                                    <span class="e-badge e-badge-info">Signed in as: @CurrentUserLabel</span>
                                                </SfTooltip>

                                                <SfTooltip Content="Conversation scope combines the user identity, selected enterprise, and fiscal-year workspace context."
                                                           Position="Syncfusion.Blazor.Popups.Position.TopCenter"
                                                           OpensOn="Hover Focus"
                                                           ShowTipPointer="true"
                                                           CloseDelay="200">
                                                    <span class="e-badge e-badge-light">@CurrentConversationLabel</span>
                                                </SfTooltip>
                                            </div>
                                        </div>
                                    </CardContent>
                                </SfCard>

                                @if (ShowXaiKeySetupPrompt)
                                {
                                    <SfCard ID="jarvis-xai-key-setup" CssClass="border-amber-400">
                                        <CardHeader Title="Would you like to add or rotate your Xai api key?"
                                                    SubTitle="Local development convenience" />
                                        <CardContent>
                                            <div class="space-y-3">
                                                <div class="text-sm wiley-text-muted">
                                                    Jarvis is running in fallback mode because no xAI (Grok) API key was found for the backend.
                                                </div>

                                                <SfTooltip Content="The xAI API key powers real Jarvis/Grok responses instead of safe deterministic fallbacks. This prompt appears during local development startup when the API reports LatestUsedFallback=true. Choosing Yes lets you paste a key; it will be written ONLY to appsettings.Development.local.json (a gitignored file on YOUR machine). In production the key comes automatically from AWS Secrets Manager / App Runner — this UI and endpoint do not exist outside Development. Never commit keys."
                                                           Position="Syncfusion.Blazor.Popups.Position.TopCenter"
                                                           OpensOn="Hover Focus"
                                                           ShowTipPointer="true"
                                                           CloseDelay="300">
                                                    <span class="text-xs underline decoration-dotted cursor-help">What's this for? (hover for plain-English explanation)</span>
                                                </SfTooltip>

                                                <div class="flex gap-3">
                                                    <SfButton CssClass="e-success" Disabled="@IsSettingXaiKey" OnClick="OnXaiKeyPromptYes">Yes, add/rotate key</SfButton>
                                                    <SfButton CssClass="e-flat" Disabled="@IsSettingXaiKey" OnClick="OnXaiKeyPromptNo">No, not now</SfButton>
                                                </div>

                                                @if (ShowXaiKeyInputForm)
                                                {
                                                    <div class="pt-2 border-t">
                                                        <label class="text-xs wiley-text-muted block mb-1">Paste your xAI key (will not be logged or shown after submit)</label>
                                                        <SfTextBox @bind-Value="XaiKeyInput"
                                                                   Type="InputType.Password"
                                                                   Placeholder="sk-..."
                                                                   CssClass="w-full"
                                                                   Enabled="!IsSettingXaiKey" />
                                                        <div class="mt-2 flex gap-2">
                                                            <SfButton CssClass="e-primary" Disabled="@(!CanSubmitXaiKey)" OnClick="SubmitXaiKeyAsync">
                                                                @(IsSettingXaiKey ? "Saving..." : "Save key for local dev")
                                                            </SfButton>
                                                        </div>
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(XaiKeySetupMessage))
                                                {
                                                    <div class="text-xs p-2 rounded bg-amber-50 border border-amber-200 wiley-text-muted">@XaiKeySetupMessage</div>
                                                }

                                                <div class="text-[10px] wiley-text-muted">
                                                    Safe storage used: .NET user secrets (recommended), launchctl, or the local json written by this flow. Matches the project's documented patterns.
                                                </div>
                                            </div>
                                        </CardContent>
                                    </SfCard>
                                }

                                @* Persistent dev-only key manager (always available in the Jarvis panel for local development).
                                   This keeps the "add xai key via jarvis chat window" as the primary/only method.
                                   Expands to the same secure form. Server-side endpoint is Development-only.
                                *@
                                @if (ShowDevKeyManager)
                                {
                                    <SfCard ID="jarvis-dev-key-manager" CssClass="border-dashed">
                                        <CardHeader Title="Dev: xAI Key (local only)" SubTitle="For evaluation — input here, never in chat or git" />
                                        <CardContent>
                                            <div class="flex items-center justify-between">
                                                <div class="text-xs wiley-text-muted">
                                                    Use this to add/rotate your xAI key via the Jarvis panel (secure browser → local API → gitignored .local.json).
                                                </div>
                                                <SfButton CssClass="e-flat e-small" OnClick="@(() => DevKeyManagerExpanded = !DevKeyManagerExpanded)">
                                                    @(DevKeyManagerExpanded ? "Collapse" : "Manage Key")
                                                </SfButton>
                                            </div>

                                            @if (DevKeyManagerExpanded)
                                            {
                                                <div class="pt-3 border-t mt-3">
                                                    @if (!string.IsNullOrWhiteSpace(XaiKeySetupMessage))
                                                    {
                                                        <div class="text-xs p-2 rounded bg-amber-50 border border-amber-200 wiley-text-muted mb-2">@XaiKeySetupMessage</div>
                                                    }

                                                    <label class="text-xs wiley-text-muted block mb-1">Paste your xAI key</label>
                                                    <SfTextBox @bind-Value="XaiKeyInput"
                                                               Type="InputType.Password"
                                                               Placeholder="sk-..."
                                                               CssClass="w-full"
                                                               Enabled="!IsSettingXaiKey" />

                                                    <div class="mt-2">
                                                        <SfButton CssClass="e-primary e-small" Disabled="@(!CanSubmitXaiKey)" OnClick="SubmitXaiKeyAsync">
                                                            @(IsSettingXaiKey ? "Saving..." : "Save / Rotate Key (local dev)")
                                                        </SfButton>
                                                    </div>

                                                    <div class="text-[10px] wiley-text-muted mt-1">
                                                        After save, restart the API process for full real-Jarvis effect. Matches documented safe local patterns.
                                                    </div>
                                                </div>
                                            }
                                        </CardContent>
                                    </SfCard>
                                }

                                @* Removed: extra custom chat shell blocks that duplicated the assist surface.
                                   Replacement: SfAIAssistView owns the stable #jarvis-chat-ui anchor (audits/Playwright) with explicit Height for a non-zero bounding box. *@
                                    <SfAIAssistView ID="@AssistViewId"
                                                    @ref="JarvisAssistView"
                                                    CssClass="scroll-mt-4 jarvis-chat-surface min-h-[24rem] rounded-2xl border border-[var(--wiley-border)] wiley-surface-panel"
                                                    Height="360px"
                                                    Width="100%"
                                                    @bind-Prompt="ChatQuestion"
                                                    PromptPlaceholder="Ask about the workspace, codebase, or AI tools"
                                                    PromptRequested="OnPromptRequestedAsync"
                                                    Prompts="ChatPrompts"
                                                    PromptSuggestions="PromptSuggestions"
                                                    PromptSuggestionsHeader="Workspace prompts">
                                        <ChildContent>
                                            <AssistViewToolbar ItemClicked="OnAssistToolbarItemClicked">
                                                <AssistViewToolbarItem Text="Refresh Guidance"
                                                                       IconCss="e-icons e-refresh"
                                                                       Tooltip="Refresh the live workspace knowledge response without leaving the Jarvis rail." />
                                                <AssistViewToolbarItem Text="Reload History"
                                                                       IconCss="e-icons e-clock"
                                                                       Tooltip="Reload recommendation history for the current workspace scope." />
                                            </AssistViewToolbar>
                                            <AssistViews>
                                                <AssistView Header="JARVIS" IconCss="e-icons e-ai-chat" ShowClearButton="true">
                                                    <BannerTemplate>
                                                        <div class="grid gap-3 lg:grid-cols-2">
                                                            <SfCard>
                                                                <CardHeader Title="Workspace context" SubTitle="Live scope shared with the rest of the shell" />
                                                                <CardContent>
                                                                    <div class="text-sm leading-6 wiley-text-muted">@ChatContextSummary</div>
                                                                </CardContent>
                                                            </SfCard>

                                                            <SfCard>
                                                                <CardHeader Title="Operator profile" SubTitle="User-context plugin summary" />
                                                                <CardContent>
                                                                    <div class="text-xs font-semibold uppercase tracking-[0.22em] wiley-text-muted">Profile summary</div>
                                                                    <div class="text-sm leading-6 wiley-text-muted">@CurrentProfileSummary</div>
                                                                </CardContent>
                                                            </SfCard>
                                                        </div>
                                                    </BannerTemplate>

                                                    <PromptItemTemplate>
                                                        <SfCard>
                                                            <CardHeader Title="You" SubTitle="@($"Prompt {context.Index + 1}")" />
                                                            <CardContent>
                                                                <div class="whitespace-pre-line text-sm wiley-text-muted">@context.Prompt</div>
                                                            </CardContent>
                                                        </SfCard>
                                                    </PromptItemTemplate>

                                                    <ResponseItemTemplate>
                                                        <SfCard>
                                                            <CardHeader Title="Jarvis" SubTitle="@($"Response {context.Index + 1}")" />
                                                            <CardContent>
                                                                <div class="space-y-2">
                                                                    <div class="text-xs wiley-text-muted">Premium assist output grounded in the current workspace snapshot and conversation scope.</div>
                                                                    <div class="whitespace-pre-line text-sm leading-6 wiley-text-muted">@context.Response</div>
                                                                </div>
                                                            </CardContent>
                                                        </SfCard>
                                                    </ResponseItemTemplate>

                                                    <FooterTemplate>
                                                        @* Removed: manual footer action row with plain button placement logic.
                                                           Replacement: the prompt editor stays inside the assist surface, while native assist footer-toolbar items now own the primary actions. *@
                                                        <SfCard>
                                                            <CardHeader Title="Compose prompt" SubTitle="Ask Jarvis about the workspace, codebase, or AI tooling." />
                                                            <CardContent>
                                                                @* MaxLength: caps prompt length at 4000 chars to stay within the Jarvis API token budget. *@
                                                                <SfTextBox ID="jarvis-question-input"
                                                                           Placeholder="Ask about the workspace, codebase, or AI tools"
                                                                           FloatLabelType="FloatLabelType.Auto"
                                                                           Multiline="true"
                                                                           Rows="3"
                                                                           ShowClearButton="true"
                                                                           MaxLength="4000"
                                                                           Width="100%"
                                                                           @bind-Value="ChatQuestion" />

                                                                <div class="mt-3 flex flex-wrap gap-3">
                                                                    <SfButton CssClass="e-primary"
                                                                              IsPrimary="true"
                                                                              Disabled="@(!CanAskChat)"
                                                                              OnClick="SubmitFooterPromptAsync">Ask Jarvis</SfButton>
                                                                    <SfButton Disabled="@IsChatBusy"
                                                                              OnClick="ResetChatAsync">Reset Thread</SfButton>
                                                                    <SfButton CssClass="e-flat"
                                                                              Disabled="@IsKnowledgeBusy"
                                                                              OnClick="RefreshKnowledgeFromButtonAsync">Refresh Context</SfButton>
                                                                </div>
                                                            </CardContent>
                                                        </SfCard>
                                                    </FooterTemplate>
                                                </AssistView>
                                            </AssistViews>
                                        </ChildContent>
                                    </SfAIAssistView>

                                <div class="grid gap-4 xl:grid-cols-2">
                                    @* Removed: custom transcript div stack.
                                       Replacement: conversation turns still render from the same state, but now live in a Syncfusion audit card instead of ad-hoc message wrappers. *@
                                    <SfCard ID="jarvis-conversation-history">
                                        <CardHeader Title="Conversation history"
                                                    SubTitle="@CurrentConversationLabel" />
                                        <CardContent>
                                            @if (ChatTranscript.Count == 0)
                                            {
                                                <div class="text-sm wiley-text-muted">No prior Jarvis turns yet.</div>
                                            }
                                            else
                                            {
                                                <div class="space-y-3">
                                                    @foreach (var message in ChatTranscript)
                                                    {
                                                        <SfCard>
                                                            <CardHeader Title="@(IsAssistantMessage(message.Role) ? "Jarvis" : "You")"
                                                                        SubTitle="Conversation history" />
                                                            <CardContent>
                                                                <div class="whitespace-pre-line text-sm wiley-text-muted">@message.Content</div>
                                                            </CardContent>
                                                        </SfCard>
                                                    }
                                                </div>
                                            }
                                        </CardContent>
                                    </SfCard>

                                    @* Removed: custom recommendation-history message divs.
                                       Replacement: a Syncfusion history card keeps recommendation audit entries readable and aligned with the broader decision-support rail. *@
                                    <SfCard ID="jarvis-recommendation-history">
                                        <CardHeader Title="Recommendation history"
                                                    SubTitle="@RecommendationHistoryStatus" />
                                        <CardContent>
                                            @if (RecommendationHistory.Count == 0)
                                            {
                                                <div class="text-sm wiley-text-muted">No saved recommendations yet for this workspace scope.</div>
                                            }
                                            else
                                            {
                                                <div class="space-y-3">
                                                    @foreach (var entry in RecommendationHistory)
                                                    {
                                                        <SfCard>
                                                            <CardHeader Title="@entry.UserDisplayName"
                                                                        SubTitle="@FormatRecommendationTimestamp(entry.CreatedAtUtc)" />
                                                            <CardContent>
                                                                <div class="space-y-2">
                                                                    <div class="text-xs wiley-text-muted">Q: @entry.Question</div>
                                                                    <div class="whitespace-pre-line text-sm wiley-text-muted">@entry.Recommendation</div>
                                                                </div>
                                                            </CardContent>
                                                        </SfCard>
                                                    }
                                                </div>
                                            }
                                        </CardContent>
                                    </SfCard>
                                </div>

                                @* Removed: the plain latest-answer strip.
                                   Replacement: a dedicated Syncfusion answer card separates current context from the latest AI response while preserving the existing automation anchor. *@
                                <SfCard ID="jarvis-chat-answer">
                                    <CardHeader Title="Latest answer" SubTitle="Current workspace context and most recent Jarvis response" />
                                    <CardContent>
                                        <div class="space-y-3" role="status" aria-live="polite" aria-busy="@IsChatBusy">
                                            <div>
                                                <div class="text-xs font-semibold uppercase tracking-[0.22em] wiley-text-muted">Context</div>
                                                <div class="mt-1 text-sm leading-6 wiley-text-muted">@ChatContextSummary</div>
                                            </div>
                                            <div class="whitespace-pre-line text-sm leading-6 wiley-text-muted">@ChatAnswer</div>
                                        </div>
                                    </CardContent>
                                </SfCard>
                            </div>
                        </CardContent>
                    </SfCard>
                }
                else
                {
                    <SfCard>
                        <CardHeader Title="Delivery note" SubTitle="Secure Jarvis is disabled for this host." />
                        <CardContent>
                            <div class="text-sm wiley-text-muted">This panel uses the same workspace state the rest of the UI reads and can call the server-side Semantic Kernel assistant when the xAI key is configured.</div>
                        </CardContent>
                    </SfCard>
                }
            </div>
        </CardContent>
    </SfCard>
</div>