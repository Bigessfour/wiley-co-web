@page "/authentication/legacy-login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.AspNetCore.Components.Authorization
@using WileyCoWeb.Services.Auth
@inject StaffAuthCoordinator StaffAuth
@inject CognitoAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Staff sign-in | Wiley.co</PageTitle>

<section class="mx-auto max-w-md rounded-3xl wiley-border wiley-surface-1 px-6 py-8 wiley-text shadow-sm">
    <p class="wiley-eyebrow wiley-eyebrow-muted">Town of Wiley</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">Staff sign-in</h1>
    <p class="mt-2 text-sm wiley-text-muted">
        Use your Cognito staff account to load live workspace data. Anonymous API calls return 401 when JWT is enabled in production.
    </p>

    @if (!StaffAuth.IsEnabled)
    {
        <p class="wiley-callout wiley-callout-warning mt-6 rounded-2xl px-4 py-3 text-sm">
            Client auth is disabled for this build (`Auth:Enabled=false`). Local development keeps the workspace open without Cognito.
        </p>
        <a class="wiley-button-dark mt-4" href="/">
            Open Town Hub
        </a>
    }
    else if (StaffAuth.UsesHostedUi)
    {
        <p class="wiley-callout wiley-callout-warning mt-6 rounded-2xl px-4 py-3 text-sm">
            Redirecting to Cognito Hosted UI…
        </p>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SignInAsync" class="mt-6 space-y-4">
            <div>
                <label class="block text-sm font-medium wiley-text-muted" for="staff-username">Username</label>
                <InputText id="staff-username"
                           @bind-Value="_model.Username"
                           class="mt-1 w-full rounded-xl wiley-border px-3 py-2 text-sm"
                           autocomplete="username" />
            </div>
            <div>
                <label class="block text-sm font-medium wiley-text-muted" for="staff-password">Password</label>
                <input id="staff-password"
                       @bind="_model.Password"
                       type="password"
                       class="mt-1 w-full rounded-xl wiley-border px-3 py-2 text-sm"
                       autocomplete="current-password" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <SignInFailure Action="login-failed" Detail="@_error" Compact="true" />
            }

            <button id="staff-sign-in-submit"
                    type="submit"
                    class="wiley-button-dark disabled:opacity-60"
                    disabled="@_busy">
                @(_busy ? "Signing in…" : "Sign in")
            </button>
        </EditForm>
    }
</section>

@code {
    private readonly LoginModel _model = new();
    private bool _busy;
    private string? _error;
    private string? _returnUrl;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        _returnUrl = SanitizeReturnUrl(ReturnUrl);
        if (StaffAuth.IsEnabled && StaffAuth.UsesHostedUi)
        {
            StaffAuth.NavigateToLogin(_returnUrl);
        }
    }

    private async Task SignInAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            await AuthService.SignInAsync(_model.Username, _model.Password).ConfigureAwait(false);
            if (AuthStateProvider is CognitoAuthenticationStateProvider cognitoAuthStateProvider)
            {
                cognitoAuthStateProvider.NotifyAuthenticationStateChanged();
            }

            Navigation.NavigateTo(string.IsNullOrWhiteSpace(_returnUrl) ? "/" : _returnUrl!);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string? SanitizeReturnUrl(string? candidate)
    {
        if (string.IsNullOrWhiteSpace(candidate))
        {
            return null;
        }

        if (Uri.TryCreate(candidate, UriKind.Absolute, out var absolute))
        {
            var appOrigin = Navigation.ToAbsoluteUri("/").GetLeftPart(UriPartial.Authority);
            if (!string.Equals(absolute.GetLeftPart(UriPartial.Authority), appOrigin, StringComparison.OrdinalIgnoreCase))
            {
                return null;
            }

            return absolute.PathAndQuery;
        }

        if (candidate.StartsWith('/') && !candidate.StartsWith("//", StringComparison.Ordinal))
        {
            return candidate;
        }

        return null;
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;
    }
}
