@page "/authentication/sso-complete"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Town sign-in | Wiley.co</PageTitle>

<section class="mx-auto max-w-md rounded-3xl wiley-border wiley-surface-1 px-6 py-8 wiley-text shadow-sm">
    <p class="wiley-eyebrow wiley-eyebrow-muted">Town of Wiley</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">Town sign-in is ready</h1>
    <p class="mt-3 text-sm">
        This browser has the town session. Apartments and Trash Truck can reuse it.
        A driver on a phone still signs in on Trash Truck.
    </p>
    <a class="wiley-button-dark mt-4" href="/">Back to Town Hub</a>
</section>
