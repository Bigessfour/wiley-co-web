@page "/"

<PageTitle>Wiley.co</PageTitle>

<section class="home-hub">
	<div class="home-hub-hero">
		<p class="home-hub-kicker">Wiley Widget</p>
		<h1>Rate Study Console</h1>
		<p class="home-hub-copy">
			Start from a focused route instead of loading the full workspace overview on the domain root.
			This keeps the entry screen lighter and makes panel navigation predictable.
		</p>
		<div class="home-hub-actions">
			<a class="home-hub-primary" href="/wiley-workspace">Open workspace overview</a>
			<a class="home-hub-secondary" href="/wiley-workspace/data-dashboard">Open data dashboard</a>
		</div>
	</div>

	<div class="home-hub-grid">
		@foreach (var item in HubItems)
		{
			<a class="home-hub-card" href="@item.Href">
				<span class="home-hub-card-index">@item.Index</span>
				<strong>@item.Label</strong>
				<p>@item.Description</p>
			</a>
		}
	</div>
</section>

@code {
	/// <summary>
	/// Keep order, labels, and destinations aligned with <c>NavMenu</c> workspace links.
	/// </summary>
	private static readonly HubItem[] HubItems =
	[
		new("01", "Workspace Overview", "/wiley-workspace", "Open the workspace overview"),
		new("02", "Break-Even", "/wiley-workspace/break-even", "Inspect rate balance and gauge inputs"),
		new("03", "Apartment Config", "/wiley-workspace/apartment-config", "Jump to the apartment configuration section"),
		new("04", "Rates", "/wiley-workspace/rates", "Adjust the live rate controls"),
		new("05", "QuickBooks Import", "/wiley-workspace/quickbooks-import", "Stage and validate QuickBooks exports"),
		new("06", "Scenario Planner", "/wiley-workspace/scenario", "Model what-if scenarios and saved snapshots"),
		new("07", "Customer Viewer", "/wiley-workspace/customers", "Review customer impacts and exports"),
		new("08", "Affordability", "/wiley-workspace/affordability", "Inspect bill burden versus MHI"),
		new("09", "Debt Coverage", "/wiley-workspace/debt-coverage", "Inspect DSCR and covenant headroom"),
		new("10", "Capital Gap", "/wiley-workspace/capital-gap", "Inspect capital needs against rate revenue"),
		new("11", "Reserve Trajectory", "/wiley-workspace/reserve-trajectory", "Inspect reserve forecast and policy floor"),
		new("12", "Trends", "/wiley-workspace/trends", "Inspect projected rate movement"),
		new("13", "Decision Support", "/wiley-workspace/decision-support", "Open Jarvis decision support"),
		new("14", "Data Dashboard", "/wiley-workspace/data-dashboard", "Open the executive dashboard"),
	];

	private sealed record HubItem(string Index, string Label, string Href, string Description);
}
