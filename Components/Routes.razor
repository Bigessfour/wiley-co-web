@using Microsoft.AspNetCore.Components.Authorization
@using WileyCoWeb.Components.Auth
@using WileyCoWeb.Services.Auth
@inject CognitoAuthService AuthService

<LoggingErrorBoundary BoundaryName="Router">
    <ChildContent>
        <CascadingAuthenticationState>
            <Router AppAssembly="typeof(Program).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                        <NotAuthorized>
                            @if (AuthService.IsEnabled && context.User.Identity?.IsAuthenticated != true)
                            {
                                <RedirectToLogin />
                            }
                            else
                            {
                                <LayoutView Layout="typeof(Layout.MainLayout)">
                                    <p class="wiley-callout wiley-callout-danger rounded-3xl px-6 py-6 text-sm">
                                        You are not authorized to view this page.
                                    </p>
                                </LayoutView>
                            }
                        </NotAuthorized>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <LayoutView Layout="typeof(Layout.MainLayout)">
                        <PageTitle>Page Not Found | Wiley.co</PageTitle>

                        <section class="wiley-callout wiley-callout-warning rounded-3xl px-6 py-6 shadow-sm">
                            <p class="wiley-eyebrow wiley-eyebrow-warning">Routing</p>
                            <h2 class="mt-2 text-2xl font-semibold tracking-tight">Page not found</h2>
                            <p class="mt-2 max-w-2xl text-sm wiley-text-muted">
                                The requested route does not match a Wiley Widget page. Return to the launcher or reopen the workspace overview.
                            </p>
                            <div class="mt-4 flex flex-wrap gap-3">
                                <a class="wiley-button-dark" href="/">Return home</a>
                                <a class="wiley-button-ghost" href="/wiley-workspace">Open workspace overview</a>
                            </div>
                        </section>
                    </LayoutView>
                </NotFound>
            </Router>
        </CascadingAuthenticationState>
    </ChildContent>
    <ErrorContent>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <PageTitle>Application Error | Wiley.co</PageTitle>

            <section id="router-error-boundary" class="wiley-callout wiley-callout-danger rounded-3xl px-6 py-6 shadow-sm">
                <p class="wiley-eyebrow wiley-eyebrow-danger">Application Error</p>
                <h2 class="mt-2 text-2xl font-semibold tracking-tight">The workspace router hit an unexpected error.</h2>
                <p class="mt-2 max-w-2xl text-sm wiley-text-muted">
                    Review the browser console and structured client logs for the full exception details, then reload the workspace or return home.
                </p>
                <div class="mt-4 flex flex-wrap gap-3">
                    <a class="wiley-button-dark" href="/wiley-workspace">Reload workspace</a>
                    <a class="wiley-button-ghost" href="/">Return home</a>
                </div>
            </section>
        </LayoutView>
    </ErrorContent>
</LoggingErrorBoundary>
