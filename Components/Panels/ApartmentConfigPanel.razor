@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.Grids
@using WileyCoWeb.Contracts

<section id="apartment-config-panel" class="space-y-4 rounded-2xl wiley-surface-panel p-4">
    <div class="flex flex-col gap-2">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] wiley-text-muted">Apartment Configuration</p>
        <p class="text-sm wiley-text-muted">Edit unit types, monthly rents, and bedroom weighting for the Apartments enterprise.</p>
    </div>

    <section id="apartment-config-summary-panel" class="grid gap-4 md:grid-cols-3">
        <SfCard ID="apartment-config-total-units-card" CssClass="wiley-panel-card">
            <CardHeader Title="Total Units" SubTitle="@TotalUnits.ToString("N0")" />
            <CardContent Content="Total apartment units represented in the current mix." />
        </SfCard>
        <SfCard ID="apartment-config-monthly-revenue-card" CssClass="wiley-panel-card">
            <CardHeader Title="Monthly Revenue" SubTitle="@TotalMonthlyRevenue.ToString("C0")" />
            <CardContent Content="Roll-up of all apartment unit-type rents." />
        </SfCard>
        <SfCard ID="apartment-config-effective-revenue-card" CssClass="wiley-panel-card">
            <CardHeader Title="Effective $/Customer" SubTitle="@EffectiveRevenuePerCustomer.ToString("C2")" />
            <CardContent Content="Revenue normalized by bedroom-weighted effective customers." />
        </SfCard>
    </section>

    <SfCard ID="apartment-config-grid-card" CssClass="wiley-panel-card">
        <CardHeader Title="Unit Type Mix"
                    SubTitle="Use the toolbar to add, edit, or delete apartment unit types. Dialog editing keeps fields readable on smaller screens." />
        <CardContent>
            <div class="workspace-syncfusion-grid-host workspace-syncfusion-grid-host--compact min-h-[320px]">
                <SfGrid ID="apartment-config-grid"
                        TValue="ApartmentUnitTypeData"
                        DataSource="@editableUnitTypes"
                        Toolbar="@ToolbarItems"
                        Width="100%"
                        Height="320px"
                        AllowPaging="true"
                        AllowSorting="true"
                        AllowEditing="true"
                        AllowAdding="true"
                        AllowDeleting="true"
                        AllowTextWrap="true"
                        EnableHover="true"
                        EnableStickyHeader="true"
                        GridLines="GridLine.Horizontal"
                        ClipMode="ClipMode.EllipsisWithTooltip"
                        EnablePersistence="true"
                        PersistenceKey="wiley.apartment-config-grid.v1">
                    <GridEvents TValue="ApartmentUnitTypeData"
                                OnActionBegin="HandleActionBegin"
                                OnActionComplete="HandleActionComplete" />
                    <GridSelectionSettings Mode="Syncfusion.Blazor.Grids.SelectionMode.Row"
                                           Type="Syncfusion.Blazor.Grids.SelectionType.Single" />
                    <GridPageSettings PageSize="8" PageCount="4" />
                    <GridEditSettings AllowAdding="true"
                                      AllowEditing="true"
                                      AllowDeleting="true"
                                      AllowEditOnDblClick="false"
                                      ShowDeleteConfirmDialog="true"
                                      Mode="Syncfusion.Blazor.Grids.EditMode.Dialog" />
                    <GridColumns>
                        <GridColumn Field="@nameof(ApartmentUnitTypeData.Id)" IsPrimaryKey="true" Visible="false" IsIdentity="false" Width="0" />
                        <GridColumn Field="@nameof(ApartmentUnitTypeData.Name)" HeaderText="Unit Type" Width="180" />
                        <GridColumn Field="@nameof(ApartmentUnitTypeData.BedroomCount)" HeaderText="Bedrooms" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                        <GridColumn Field="@nameof(ApartmentUnitTypeData.UnitCount)" HeaderText="Units" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                        <GridColumn Field="@nameof(ApartmentUnitTypeData.MonthlyRent)" HeaderText="Monthly Rent" Format="C2" Width="140" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                    </GridColumns>
                    <GridTemplates>
                        <EmptyRecordTemplate>
                            <div class="p-4 text-sm wiley-text-muted">
                                <p class="font-semibold wiley-text-primary">No unit types defined</p>
                                <p class="mt-1">Add apartment configurations to model revenue. Use the toolbar above to add your first unit type.</p>
                            </div>
                        </EmptyRecordTemplate>
                    </GridTemplates>
                </SfGrid>
            </div>
        </CardContent>
    </SfCard>
</section>

@code {
    [Parameter] public IReadOnlyList<ApartmentUnitTypeData> UnitTypes { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<ApartmentUnitTypeData>> OnUnitTypesChanged { get; set; }

    private static IReadOnlyList<string> ToolbarItems { get; } = ["Add", "Edit", "Delete", "Update", "Cancel"];
    private List<ApartmentUnitTypeData> editableUnitTypes = [];

    protected override void OnParametersSet()
    {
        editableUnitTypes = UnitTypes
            .Select(unitType => new ApartmentUnitTypeData(unitType.Id, unitType.Name, unitType.BedroomCount, unitType.UnitCount, unitType.MonthlyRent))
            .ToList();
    }

    private decimal TotalUnits => editableUnitTypes.Sum(unitType => unitType.UnitCount);

    private decimal TotalMonthlyRevenue => editableUnitTypes.Sum(unitType => unitType.UnitCount * unitType.MonthlyRent);

    private decimal EffectiveCustomerCount => editableUnitTypes.Sum(unitType => unitType.UnitCount * unitType.BedroomCount);

    private decimal EffectiveRevenuePerCustomer => EffectiveCustomerCount > 0 ? TotalMonthlyRevenue / EffectiveCustomerCount : 0m;

    private static void HandleActionBegin(ActionEventArgs<ApartmentUnitTypeData> args)
    {
        if (args.RequestType is Syncfusion.Blazor.Grids.Action.Add)
        {
            args.Data = new ApartmentUnitTypeData(Guid.NewGuid(), string.Empty, 1, 0, 0m);
        }
    }

    private async Task HandleActionComplete(ActionEventArgs<ApartmentUnitTypeData> args)
    {
        if (args.RequestType is Syncfusion.Blazor.Grids.Action.Save or Syncfusion.Blazor.Grids.Action.Delete)
        {
            await OnUnitTypesChanged.InvokeAsync(editableUnitTypes.ToList());
        }

        await InvokeAsync(StateHasChanged);
    }
}
