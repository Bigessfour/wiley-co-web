@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.Charts
@using Syncfusion.Blazor.CircularGauge
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using WileyCoWeb.Contracts
@using WileyCoWeb.State
@using WileyWidget.Abstractions

<div class="space-y-6" id="data-dashboard-panel">

    @if (!string.IsNullOrWhiteSpace(CostSource))
    {
        <p class="text-xs wiley-text-muted">Cost source: <span class="font-semibold wiley-text">QuickBooks @CostSource · FY@SelectedFiscalYear</span></p>
    }

    @* ─── KPI ROW ────────────────────────────────────────────────────────────── *@
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <SfCard ID="kpi-net-position">
            <CardHeader Title="Net Monthly Position" SubTitle="@(SelectedEnterprise + " · FY" + SelectedFiscalYear)" />
            <CardContent>
                <p class="text-2xl font-bold @(NetPosition >= 0 ? "text-emerald-600" : "text-rose-600")">@NetPosition.ToString("C0")</p>
                <p class="mt-1 text-xs wiley-text-muted">Monthly Revenue @MonthlyRevenue.ToString("C0") − Total Costs @TotalCosts.ToString("C0")</p>
            </CardContent>
        </SfCard>
        <SfCard ID="kpi-coverage-ratio">
            <CardHeader Title="Coverage Ratio" SubTitle="Revenue ÷ Costs" />
            <CardContent>
                <p class="text-2xl font-bold @(CoverageRatio >= 1.25 ? "text-emerald-600" : (CoverageRatio >= 1.0 ? "text-amber-600" : "text-rose-600"))">@CoverageRatio.ToString("F2")×</p>
                <p class="mt-1 text-xs wiley-text-muted">Target ≥ 1.25×</p>
            </CardContent>
        </SfCard>
        <SfCard ID="kpi-rate-adequacy">
            <CardHeader Title="Rate Adequacy" SubTitle="Current ÷ Break-Even" />
            <CardContent>
                <p class="text-2xl font-bold @(RateAdequacy >= 100 ? "text-emerald-600" : (RateAdequacy >= 85 ? "text-amber-600" : "text-rose-600"))">@RateAdequacy.ToString("F1")%</p>
                <p class="mt-1 text-xs wiley-text-muted">Current @CurrentRate.ToString("C2") · Break-Even @RecommendedRate.ToString("C2")</p>
            </CardContent>
        </SfCard>
        <SfCard ID="kpi-scenario-pressure">
            <CardHeader Title="Scenario Pressure" SubTitle="What-if cost additions" />
            <CardContent>
                <p class="text-2xl font-bold @(ScenarioCostTotal > 0 ? "text-amber-600" : "wiley-text-muted")">@ScenarioCostTotal.ToString("C0")</p>
                <p class="mt-1 text-xs wiley-text-muted">Scenario break-even @AdjustedRecommendedRate.ToString("C2")</p>
            </CardContent>
        </SfCard>
    </div>

    @* ─── COMPACT GAUGE STRIP (side-by-side) ─────────────────────────────────── *@
    <div id="data-dashboard-gauge-grid" class="data-dashboard-gauge-grid">
        <div class="wiley-surface-panel p-3" role="img" aria-label="Coverage ratio gauge showing revenue divided by costs">
            <p class="mb-1 text-sm font-semibold wiley-text">Coverage Ratio</p>
            <p class="mb-2 text-xs wiley-text-muted">Revenue ÷ Costs · Target ≥ 1.25×</p>
            <div class="wiley-gauge-viewport data-dashboard-gauge-viewport">
            <SfCircularGauge ID="coverage-ratio-gauge"
                             EnableGroupingSeparator="false"
                             AllowMargin="true"
                             AnimationDuration="700"
                             Width="100%"
                             Height="100%">
                <CircularGaugeAxes>
                    <CircularGaugeAxis Minimum="0" Maximum="2.5" StartAngle="210" EndAngle="150" Radius="80%">
                        <CircularGaugeAxisLineStyle Width="8" Color="#e2e8f0" />
                        <CircularGaugeAxisLabelStyle Format="{value}×">
                            <CircularGaugeAxisLabelFont Size="10px" />
                        </CircularGaugeAxisLabelStyle>
                        <CircularGaugeRanges>
                            <CircularGaugeRange Start="0" End="1.0" Color="#fca5a5" StartWidth="8" EndWidth="8" />
                            <CircularGaugeRange Start="1.0" End="1.25" Color="#fde68a" StartWidth="8" EndWidth="8" />
                            <CircularGaugeRange Start="1.25" End="2.5" Color="#6ee7b7" StartWidth="8" EndWidth="8" />
                        </CircularGaugeRanges>
                        <CircularGaugePointers>
                            <CircularGaugePointer Value="@Math.Min(CoverageRatio, 2.5)" Radius="70%" Color="#0f172a" />
                        </CircularGaugePointers>
                    </CircularGaugeAxis>
                </CircularGaugeAxes>
            </SfCircularGauge>
            </div>
        </div>
        <div class="wiley-surface-panel p-3" role="img" aria-label="Rate adequacy gauge showing current rate versus break-even rate">
            <p class="mb-1 text-sm font-semibold wiley-text">Rate Adequacy</p>
            <p class="mb-2 text-xs wiley-text-muted">Current ÷ Break-Even · Target ≥ 100%</p>
            <div class="wiley-gauge-viewport data-dashboard-gauge-viewport">
            <SfCircularGauge ID="rate-adequacy-gauge"
                             EnableGroupingSeparator="false"
                             AllowMargin="true"
                             AnimationDuration="700"
                             Width="100%"
                             Height="100%">
                <CircularGaugeAxes>
                    <CircularGaugeAxis Minimum="0" Maximum="150" StartAngle="210" EndAngle="150" Radius="80%">
                        <CircularGaugeAxisLineStyle Width="8" Color="#e2e8f0" />
                        <CircularGaugeAxisLabelStyle Format="{value}%">
                            <CircularGaugeAxisLabelFont Size="10px" />
                        </CircularGaugeAxisLabelStyle>
                        <CircularGaugeRanges>
                            <CircularGaugeRange Start="0" End="85" Color="#fca5a5" StartWidth="8" EndWidth="8" />
                            <CircularGaugeRange Start="85" End="100" Color="#fde68a" StartWidth="8" EndWidth="8" />
                            <CircularGaugeRange Start="100" End="150" Color="#6ee7b7" StartWidth="8" EndWidth="8" />
                        </CircularGaugeRanges>
                        <CircularGaugePointers>
                            <CircularGaugePointer Value="@Math.Min(RateAdequacy, 150)" Radius="70%" Color="#0f172a" />
                        </CircularGaugePointers>
                    </CircularGaugeAxis>
                </CircularGaugeAxes>
            </SfCircularGauge>
            </div>
        </div>
    </div>

    @* ─── COUNCIL DASHBOARD: 4 Enterprise Health Cards + Interactive Overhead Sliders ───
       Surgical addition for City Council audience. Beautiful, responsive 4-card grid.
       KPIs: Net Contribution (after overhead), Holds its own / Vampire flag + $ impact.
       Uses existing BreakEvenQuadrants (categorized QB data) + EnterpriseRateService + new overhead helpers (from prior backend).
       Interactive sliders (global % from AppSettings defaults) update cards live.
       No bloat: reuses SfCard, existing comparison data, colors (emerald/rose), wiley- classes.
       Drill: click name (focus/select in workspace shell). Trend: leverage existing chart workbench below.
       Council-ready: existing PDF export in shell covers packet (or enhance).
       Responsive: 1-col mobile, 2 tablet, 4 desktop.
    *@
    <section id="council-enterprise-health-dashboard" class="wiley-surface-panel p-4 mt-4">
        <div class="flex items-center justify-between mb-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] wiley-text-muted">Council View · Enterprise Health</p>
                <h3 class="text-base font-semibold">4 Enterprises: Healthy vs. Vampire Indicators</h3>
                <p class="text-xs wiley-text-muted">Net Contribution = Revenue − Direct Costs − (Total Overhead % × Direct Costs as share). Adjust global overhead to model impact (defaults match AppSettings).</p>
            </div>
            <div class="text-xs wiley-text-muted">Total OH: <span class="font-semibold">@TotalOverheadPercent.ToString("F1")</span>%</div>
        </div>

        @* Interactive overhead sliders (global; surgical, live update, no persist bloat here) *@
        <div class="mb-4 grid grid-cols-1 md:grid-cols-3 gap-3 p-3 bg-slate-50 rounded-xl border">
            <div>
                <label class="text-xs font-medium wiley-text-muted block mb-1">Town Overhead %</label>
                <SfNumericTextBox TValue="decimal" Value="@TownOverheadPercent" Step="0.5m" Min="0" Max="50" Format="0.0" Width="100%"
                                  ValueChanged="@(v => { TownOverheadPercent = v; /* live re-render */ })" />
            </div>
            <div>
                <label class="text-xs font-medium wiley-text-muted block mb-1">Management Expense %</label>
                <SfNumericTextBox TValue="decimal" Value="@ManagementExpensePercent" Step="0.5m" Min="0" Max="50" Format="0.0" Width="100%"
                                  ValueChanged="@(v => { ManagementExpensePercent = v; })" />
            </div>
            <div>
                <label class="text-xs font-medium wiley-text-muted block mb-1">Labor %</label>
                <SfNumericTextBox TValue="decimal" Value="@LaborPercent" Step="0.5m" Min="0" Max="50" Format="0.0" Width="100%"
                                  ValueChanged="@(v => { LaborPercent = v; })" />
            </div>
            <div class="md:col-span-3 text-[10px] wiley-text-muted">Sliders model global overhead. Cards recompute Net Contribution + flags instantly. Use "Save Baseline" in shell for persistence. Per-enterprise overrides via future workspace inputs.</div>
        </div>

        @* 4 beautiful enterprise cards (responsive grid) *@
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
            @foreach (var row in EnhancedEnterpriseComparison)
            {
                var isHealthy = row.HoldsItsOwn;
                var badgeClass = isHealthy ? "e-badge e-badge-success" : "e-badge e-badge-danger";
                var badgeText = isHealthy ? "Holds its own ✓" : "Vampire-feeding ⚠";
                var netClass = isHealthy ? "text-emerald-600" : "text-rose-600";
                <SfCard CssClass="@($"wiley-panel-card wiley-kpi-card min-w-0 border-l-4 {(row.HoldsItsOwn ? "border-emerald-500" : "border-rose-500")}")">
                    <CardHeader Title="@row.EnterpriseName" SubTitle="FY@SelectedFiscalYear · Categorized QB" />
                    <CardContent>
                        <div class="flex items-baseline gap-2">
                            <span class="text-2xl font-bold @netClass">@row.NetContribution.ToString("C0")</span>
                            <span class="@badgeClass text-[10px] px-1.5 py-0.5 rounded">@badgeText</span>
                        </div>
                        <div class="mt-1 text-[10px] wiley-text-muted space-y-0.5">
                            <div>Direct (costs): @row.MonthlyCosts.ToString("C0")</div>
                            <div>Overhead burden: @row.OverheadBurden.ToString("C0") (@TotalOverheadPercent.ToString("F1")%)</div>
                            <div>Revenue: @row.MonthlyRevenue.ToString("C0")</div>
                            @if (!isHealthy)
                            {
                                <div class="text-rose-600 font-medium">Impact: @row.VampireImpact.ToString("C0") shortfall</div>
                            }
                        </div>
                        <div class="mt-2 text-[10px]">
                            <button type="button" class="text-sky-600 hover:underline text-xs" @onclick="() => DrillToEnterprise(row.EnterpriseName)">
                                Drill to transactions →
                            </button>
                        </div>
                    </CardContent>
                </SfCard>
            }
        </div>
        <p class="mt-2 text-[10px] wiley-text-muted">Click drill to focus enterprise in workspace (selects + filters views). Full trends in Chart Workbench below. Export via shell PDF for council packet (includes current snapshot + this view).</p>
    </section>

    @* ─── CHART WORKBENCH (tabbed: variance · waterfall · trend) ─────────────── *@
    @if (true) // HasChartWorkbench - resolved from merge; always enabled for full council dashboard experience
    {
        <section id="data-dashboard-charts-workbench" class="wiley-surface-panel p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.25em] wiley-text-muted">Chart Workbench</p>
            <SfTab ID="data-dashboard-charts-tab"
                   CssClass="data-dashboard-charts-tab mt-3"
                   LoadOn="ContentLoad.Init"
                   OverflowMode="OverflowMode.Scrollable"
                   EnablePersistence="true"
                   PersistenceKey="wiley.data-dashboard-charts.v1">
                <TabItems>
                    @if (RateComparison.Count > 0)
                    {
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Rate Comparison" />
                            </ChildContent>
                            <ContentTemplate>
                                <div id="rate-comparison-section" class="pt-1">
                                    <p class="mb-2 text-sm font-semibold wiley-text">Budget variance · rate comparison</p>
                                    <div class="wiley-chart-viewport--tabbed">
                                    <SfChart ID="budget-variance-chart"
                                             AccessibilityDescription="Bar chart showing the rate comparison values used in the executive dashboard."
                                             Width="100%"
                                             Height="100%"
                                             Background="transparent"
                                             Theme="Syncfusion.Blazor.Theme.Fluent2">
                                        <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                                            <ChartAxisMajorGridLines Width="0" />
                                        </ChartPrimaryXAxis>
                                        <ChartPrimaryYAxis LabelFormat="C2">
                                            <ChartAxisMajorGridLines DashArray="4,4" Color="#e2e8f0" />
                                        </ChartPrimaryYAxis>
                                        <ChartZoomSettings EnableSelectionZooming="false" />
                                        <ChartTooltipSettings Enable="true" Header="<b>${point.x}</b>" Format="${point.x}: <b>${point.y}</b>" />
                                        <ChartLegendSettings Visible="false" />
                                        <ChartSeriesCollection>
                                            <ChartSeries DataSource="@RateComparison"
                                                         XName="@nameof(RateComparisonPoint.Label)"
                                                         YName="@nameof(RateComparisonPoint.Value)"
                                                         Name="Rate"
                                                         Type="ChartSeriesType.Column"
                                                         Fill="#93c5fd"
                                                         ColumnSpacing="0.2">
                                                <ChartMarker>
                                                    <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top" Format="C2">
                                                        <ChartDataLabelFont Size="10px" />
                                                    </ChartDataLabel>
                                                </ChartMarker>
                                            </ChartSeries>
                                        </ChartSeriesCollection>
                                    </SfChart>
                                    </div>
                                </div>
                            </ContentTemplate>
                        </TabItem>
                    }
                    @if (WaterfallPoints.Count > 1)
                    {
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Scenario Waterfall" />
                            </ChildContent>
                            <ContentTemplate>
                                <div id="waterfall-section" class="pt-1">
                                    <p class="mb-2 text-sm font-semibold wiley-text">Scenario cost build-up</p>
                                    <div class="wiley-chart-viewport--tabbed">
                                    <SfChart ID="scenario-waterfall-chart"
                                             AccessibilityDescription="Waterfall chart showing how scenario costs build toward the final rate impact."
                                             Width="100%"
                                             Height="100%"
                                             Background="transparent"
                                             Theme="Syncfusion.Blazor.Theme.Fluent2">
                                        <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                                            <ChartAxisMajorGridLines Width="0" />
                                        </ChartPrimaryXAxis>
                                        <ChartPrimaryYAxis LabelFormat="C0">
                                            <ChartAxisMajorGridLines DashArray="4,4" Color="#e2e8f0" />
                                        </ChartPrimaryYAxis>
                                        <ChartZoomSettings EnableSelectionZooming="false" />
                                        <ChartTooltipSettings Enable="true" Header="<b>${point.x}</b>" />
                                        <ChartLegendSettings Visible="false" />
                                        <ChartSeriesCollection>
                                            <ChartSeries DataSource="@WaterfallPoints"
                                                         XName="@nameof(WaterfallPoint.Label)"
                                                         YName="@nameof(WaterfallPoint.Value)"
                                                         Name="Cost"
                                                         Type="ChartSeriesType.Waterfall"
                                                         SumIndexes="@WaterfallSumIndexes"
                                                         NegativeFillColor="#fca5a5"
                                                         SummaryFillColor="#475569"
                                                         Fill="#93c5fd">
                                                <ChartMarker>
                                                    <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top" Format="C0">
                                                        <ChartDataLabelFont Size="10px" />
                                                    </ChartDataLabel>
                                                </ChartMarker>
                                            </ChartSeries>
                                        </ChartSeriesCollection>
                                    </SfChart>
                                    </div>
                                </div>
                            </ContentTemplate>
                        </TabItem>
                    }
                    @if (ProjectionSeries.Count > 0)
                    {
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Rate Trend" />
                            </ChildContent>
                            <ContentTemplate>
                                <div id="rate-trend-section" class="pt-1">
                                    <p class="mb-2 text-sm font-semibold wiley-text">Historical and projected rates</p>
                                    <div class="wiley-chart-viewport--tabbed">
                                    <SfChart ID="rate-trend-chart"
                                             AccessibilityDescription="Line chart showing the historical and projected rate trend."
                                             Width="100%"
                                             Height="100%"
                                             Background="transparent"
                                             Theme="Syncfusion.Blazor.Theme.Fluent2">
                                        <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                                            <ChartAxisMajorGridLines Width="0" />
                                        </ChartPrimaryXAxis>
                                        <ChartPrimaryYAxis LabelFormat="C2">
                                            <ChartAxisMajorGridLines DashArray="4,4" Color="#e2e8f0" />
                                        </ChartPrimaryYAxis>
                                        <ChartZoomSettings EnableSelectionZooming="true" EnableScrollbar="true" />
                                        <ChartTooltipSettings Enable="true" Header="<b>Year ${point.x}</b>" />
                                        <ChartCrosshairSettings Enable="true" LineType="LineType.Both">
                                            <ChartCrosshairLine Color="#94a3b8" Width="1" />
                                        </ChartCrosshairSettings>
                                        <ChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Top" />
                                        <ChartSeriesCollection>
                                            <ChartSeries DataSource="@ProjectionSeries"
                                                         XName="@nameof(ProjectionRow.Year)"
                                                         YName="@nameof(ProjectionRow.Rate)"
                                                         Name="Projected Rate"
                                                         Type="ChartSeriesType.Line"
                                                         Fill="#6366f1"
                                                         Width="2">
                                                <ChartMarker Visible="true" Height="8" Width="8" Fill="#6366f1">
                                                    <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top" Format="C2">
                                                        <ChartDataLabelFont Size="10px" />
                                                    </ChartDataLabel>
                                                </ChartMarker>
                                            </ChartSeries>
                                        </ChartSeriesCollection>
                                    </SfChart>
                                    </div>
                                </div>
                            </ContentTemplate>
                        </TabItem>
                    }
                </TabItems>
            </SfTab>
        </section>
    }

    @if (EnterpriseComparisonRows.Count > 0)
    {
        <div id="enterprise-comparison-matrix" class="wiley-surface-panel p-4">
            <p class="mb-3 text-sm font-semibold wiley-text">Enterprise comparison (ledger-sourced costs)</p>
            <div class="overflow-x-auto">
                <table class="min-w-full text-left text-sm">
                    <thead class="text-xs uppercase tracking-wide wiley-text-muted">
                        <tr>
                            <th class="px-3 py-2">Enterprise</th>
                            <th class="px-3 py-2">Monthly costs</th>
                            <th class="px-3 py-2">Monthly revenue</th>
                            <th class="px-3 py-2">Net</th>
                            <th class="px-3 py-2">Break-even rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in EnterpriseComparisonRows)
                        {
                            <tr class="border-t border-[var(--wiley-border)]">
                                <td class="px-3 py-2 font-semibold">@row.EnterpriseName</td>
                                <td class="px-3 py-2">@row.MonthlyCosts.ToString("C0")</td>
                                <td class="px-3 py-2">@row.MonthlyRevenue.ToString("C0")</td>
                                <td class="px-3 py-2 @(row.NetPosition >= 0 ? "text-emerald-600" : "text-rose-600")">@row.NetPosition.ToString("C0")</td>
                                <td class="px-3 py-2">@row.BreakEvenRate.ToString("C2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ─── CIRCULAR GAUGES + RATE CHART WORKBENCH ─────────────────────────────── *@
    <div class="grid gap-4 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="wiley-surface-panel p-4" role="img" aria-label="Coverage ratio gauge showing revenue divided by costs">
            <p class="mb-1 text-sm font-semibold wiley-text">Coverage Ratio</p>
            <p class="mb-2 text-xs wiley-text-muted">Revenue ÷ Costs · Target ≥ 1.25×</p>
            <SfCircularGauge ID="coverage-ratio-gauge"
                             EnableGroupingSeparator="false"
                             AllowMargin="true"
                             AnimationDuration="700"
                             Width="100%"
                             Height="200px">
                <CircularGaugeAxes>
                    <CircularGaugeAxis Minimum="0" Maximum="2.5" StartAngle="210" EndAngle="150" Radius="80%">
                        <CircularGaugeAxisLineStyle Width="8" Color="#e2e8f0" />
                        <CircularGaugeAxisLabelStyle Format="{value}×">
                            <CircularGaugeAxisLabelFont Size="10px" />
                        </CircularGaugeAxisLabelStyle>
                        <CircularGaugeRanges>
                            <CircularGaugeRange Start="0" End="1.0" Color="#fca5a5" StartWidth="8" EndWidth="8" />
                            <CircularGaugeRange Start="1.0" End="1.25" Color="#fde68a" StartWidth="8" EndWidth="8" />
                            <CircularGaugeRange Start="1.25" End="2.5" Color="#6ee7b7" StartWidth="8" EndWidth="8" />
                        </CircularGaugeRanges>
                        <CircularGaugePointers>
                            <CircularGaugePointer Value="@Math.Min(CoverageRatio, 2.5)" Radius="70%" Color="#0f172a" />
                        </CircularGaugePointers>
                    </CircularGaugeAxis>
                </CircularGaugeAxes>
            </SfCircularGauge>
        </div>
        <div class="wiley-surface-panel p-4" role="img" aria-label="Rate adequacy gauge showing current rate versus break-even rate">
            <p class="mb-1 text-sm font-semibold wiley-text">Rate Adequacy</p>
            <p class="mb-2 text-xs wiley-text-muted">Current ÷ Break-Even · Target ≥ 100%</p>
            <SfCircularGauge ID="rate-adequacy-gauge"
                             EnableGroupingSeparator="false"
                             AllowMargin="true"
                             AnimationDuration="700"
                             Width="100%"
                             Height="200px">
                <CircularGaugeAxes>
                    <CircularGaugeAxis Minimum="0" Maximum="150" StartAngle="210" EndAngle="150" Radius="80%">
                        <CircularGaugeAxisLineStyle Width="8" Color="#e2e8f0" />
                        <CircularGaugeAxisLabelStyle Format="{value}%">
                            <CircularGaugeAxisLabelFont Size="10px" />
                        </CircularGaugeAxisLabelStyle>
                        <CircularGaugeRanges>
                            <CircularGaugeRange Start="0" End="85" Color="#fca5a5" StartWidth="8" EndWidth="8" />
                            <CircularGaugeRange Start="85" End="100" Color="#fde68a" StartWidth="8" EndWidth="8" />
                            <CircularGaugeRange Start="100" End="150" Color="#6ee7b7" StartWidth="8" EndWidth="8" />
                        </CircularGaugeRanges>
                        <CircularGaugePointers>
                            <CircularGaugePointer Value="@Math.Min(RateAdequacy, 150)" Radius="70%" Color="#0f172a" />
                        </CircularGaugePointers>
                    </CircularGaugeAxis>
                </CircularGaugeAxes>
            </SfCircularGauge>
        </div>
    </div>

    @* ─── RATE COMPARISON BAR CHART ──────────────────────────────────────────── *@
    @if (RateComparison.Count > 0)
    {
        <div id="rate-comparison-section" class="wiley-surface-panel p-4 lg:col-span-2">
            <p class="mb-3 text-sm font-semibold wiley-text">Rate Comparison</p>
            @* Theme Fluent2: consistent with app-wide Syncfusion theme; ZoomSettings disabled — this is a KPI comparison chart not an analysis surface *@
            <SfChart ID="budget-variance-chart"
                     AccessibilityDescription="Bar chart showing the rate comparison values used in the executive dashboard."
                     Width="100%"
                     Height="300px"
                     Background="transparent"
                     Theme="Syncfusion.Blazor.Theme.Fluent2">
                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                    <ChartAxisMajorGridLines Width="0" />
                </ChartPrimaryXAxis>
                <ChartPrimaryYAxis LabelFormat="C2">
                    <ChartAxisMajorGridLines DashArray="4,4" Color="#e2e8f0" />
                </ChartPrimaryYAxis>
                <ChartZoomSettings EnableSelectionZooming="false" />
                <ChartTooltipSettings Enable="true" Header="<b>${point.x}</b>" Format="${point.x}: <b>${point.y}</b>" />
                <ChartLegendSettings Visible="false" />
                <ChartSeriesCollection>
                    <ChartSeries DataSource="@RateComparison"
                                 XName="@nameof(RateComparisonPoint.Label)"
                                 YName="@nameof(RateComparisonPoint.Value)"
                                 Name="Rate"
                                 Type="ChartSeriesType.Column"
                                 Fill="#93c5fd"
                                 ColumnSpacing="0.2">
                        <ChartMarker>
                            <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top" Format="C2">
                                <ChartDataLabelFont Size="10px" />
                            </ChartDataLabel>
                        </ChartMarker>
                    </ChartSeries>
                </ChartSeriesCollection>
            </SfChart>
        </div>
    }

    @* ─── SCENARIO WATERFALL ─────────────────────────────────────────────────── *@
    @if (WaterfallPoints.Count > 1)
    {
        <div id="waterfall-section" class="wiley-surface-panel p-4">
            <p class="mb-3 text-sm font-semibold wiley-text">Scenario Cost Waterfall</p>
            @* Theme Fluent2: aligns waterfall colours with Fluent2 palette *@
            <SfChart ID="scenario-waterfall-chart"
                     AccessibilityDescription="Waterfall chart showing how scenario costs build toward the final rate impact."
                     Width="100%"
                     Height="300px"
                     Background="transparent"
                     Theme="Syncfusion.Blazor.Theme.Fluent2">
                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                    <ChartAxisMajorGridLines Width="0" />
                </ChartPrimaryXAxis>
                <ChartPrimaryYAxis LabelFormat="C0">
                    <ChartAxisMajorGridLines DashArray="4,4" Color="#e2e8f0" />
                </ChartPrimaryYAxis>
                <ChartZoomSettings EnableSelectionZooming="false" />
                <ChartTooltipSettings Enable="true" Header="<b>${point.x}</b>" />
                <ChartLegendSettings Visible="false" />
                <ChartSeriesCollection>
                    <ChartSeries DataSource="@WaterfallPoints"
                                 XName="@nameof(WaterfallPoint.Label)"
                                 YName="@nameof(WaterfallPoint.Value)"
                                 Name="Cost"
                                 Type="ChartSeriesType.Waterfall"
                                 SumIndexes="@WaterfallSumIndexes"
                                 NegativeFillColor="#fca5a5"
                                 SummaryFillColor="#475569"
                                 Fill="#93c5fd">
                        <ChartMarker>
                            <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top" Format="C0">
                                <ChartDataLabelFont Size="10px" />
                            </ChartDataLabel>
                        </ChartMarker>
                    </ChartSeries>
                </ChartSeriesCollection>
            </SfChart>
        </div>
    }

    @* ─── RATE TREND ─────────────────────────────────────────────────────────── *@
    @if (ProjectionSeries.Count > 0)
    {
        <div id="rate-trend-section" class="wiley-surface-panel p-4">
            <p class="mb-3 text-sm font-semibold wiley-text">Rate Trend &amp; Projection</p>
            @* Theme Fluent2 + ZoomSettings: trend chart is analytical; selection zoom allows rate-period drill-down *@
            <SfChart ID="rate-trend-chart"
                     AccessibilityDescription="Line chart showing the historical and projected rate trend."
                     Width="100%"
                     Height="300px"
                     Background="transparent"
                     Theme="Syncfusion.Blazor.Theme.Fluent2">
                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category">
                    <ChartAxisMajorGridLines Width="0" />
                </ChartPrimaryXAxis>
                <ChartPrimaryYAxis LabelFormat="C2">
                    <ChartAxisMajorGridLines DashArray="4,4" Color="#e2e8f0" />
                </ChartPrimaryYAxis>
                <ChartZoomSettings EnableSelectionZooming="true" EnableScrollbar="true" />
                <ChartTooltipSettings Enable="true" Header="<b>Year ${point.x}</b>" />
                <ChartCrosshairSettings Enable="true" LineType="LineType.Both">
                    <ChartCrosshairLine Color="#94a3b8" Width="1" />
                </ChartCrosshairSettings>
                <ChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Top" />
                <ChartSeriesCollection>
                    <ChartSeries DataSource="@ProjectionSeries"
                                 XName="@nameof(ProjectionRow.Year)"
                                 YName="@nameof(ProjectionRow.Rate)"
                                 Name="Projected Rate"
                                 Type="ChartSeriesType.Line"
                                 Fill="#6366f1"
                                 Width="2">
                        <ChartMarker Visible="true" Height="8" Width="8" Fill="#6366f1">
                            <ChartDataLabel Visible="true" Position="Syncfusion.Blazor.Charts.LabelPosition.Top" Format="C2">
                                <ChartDataLabelFont Size="10px" />
                            </ChartDataLabel>
                        </ChartMarker>
                    </ChartSeries>
                </ChartSeriesCollection>
            </SfChart>
        </div>
    }

    @* ─── CUSTOMER DISTRIBUTION DONUTS ───────────────────────────────────────── *@
    @if (CustomersByService.Count > 0 || CustomersByCityLimits.Count > 0)
    {
        <div id="customer-donuts-section" class="grid gap-4 md:grid-cols-2">
            <div class="wiley-surface-panel p-4" role="img" aria-label="Customers by service type donut chart">
                <p class="mb-3 text-sm font-semibold wiley-text">Customers by Service Type</p>
                <SfAccumulationChart ID="customer-service-chart"
                                     EnableAnimation="true"
                                     Background="transparent"
                                     Height="280px">
                    <AccumulationChartTooltipSettings Enable="true" Format="${point.x}: <b>${point.y}</b>" />
                    <AccumulationChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom" />
                    <AccumulationChartSeriesCollection>
                        <AccumulationChartSeries DataSource="@CustomersByService"
                                                 XName="@nameof(PiePoint.Label)"
                                                 YName="@nameof(PiePoint.Count)"
                                                 Name="Service Type"
                                                 InnerRadius="40%"
                                                 Explode="true"
                                                 ExplodeOffset="10%"
                                                 ExplodeIndex="0">
                            <AccumulationDataLabelSettings Visible="true"
                                                           Position="AccumulationLabelPosition.Outside"
                                                           Name="@nameof(PiePoint.Label)">
                                <AccumulationChartDataLabelFont Size="11px" />
                            </AccumulationDataLabelSettings>
                        </AccumulationChartSeries>
                    </AccumulationChartSeriesCollection>
                </SfAccumulationChart>
            </div>
            <div class="wiley-surface-panel p-4" role="img" aria-label="Customers by city limits donut chart">
                <p class="mb-3 text-sm font-semibold wiley-text">Customers by City Limits</p>
                <SfAccumulationChart ID="customer-citylimits-chart"
                                     EnableAnimation="true"
                                     Background="transparent"
                                     Height="280px">
                    <AccumulationChartTooltipSettings Enable="true" Format="${point.x}: <b>${point.y}</b>" />
                    <AccumulationChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom" />
                    <AccumulationChartSeriesCollection>
                        <AccumulationChartSeries DataSource="@CustomersByCityLimits"
                                                 XName="@nameof(PiePoint.Label)"
                                                 YName="@nameof(PiePoint.Count)"
                                                 Name="City Limits"
                                                 InnerRadius="40%"
                                                 Explode="true"
                                                 ExplodeOffset="10%"
                                                 ExplodeIndex="0">
                            <AccumulationDataLabelSettings Visible="true"
                                                           Position="AccumulationLabelPosition.Outside"
                                                           Name="@nameof(PiePoint.Label)">
                                <AccumulationChartDataLabelFont Size="11px" />
                            </AccumulationDataLabelSettings>
                        </AccumulationChartSeries>
                    </AccumulationChartSeriesCollection>
                </SfAccumulationChart>
            </div>
        </div>
    }
</div>

@code {
    // ── Parameters ────────────────────────────────────────────────────────────
    [Parameter] public decimal CurrentRate { get; set; }
    [Parameter] public decimal TotalCosts { get; set; }
    [Parameter] public decimal ProjectedVolume { get; set; }
    [Parameter] public decimal RecommendedRate { get; set; }
    [Parameter] public decimal AdjustedRecommendedRate { get; set; }
    [Parameter] public decimal ScenarioCostTotal { get; set; }
    [Parameter] public IReadOnlyList<ScenarioItem> ScenarioItems { get; set; } = [];
    [Parameter] public IReadOnlyList<ProjectionRow> ProjectionSeries { get; set; } = [];
    [Parameter] public IReadOnlyList<CustomerRow> Customers { get; set; } = [];
    [Parameter] public IReadOnlyList<RateComparisonPoint> RateComparison { get; set; } = [];
    [Parameter] public string SelectedEnterprise { get; set; } = string.Empty;
    [Parameter] public int SelectedFiscalYear { get; set; }
    [Parameter] public string? CostSource { get; set; }
    [Parameter] public IReadOnlyList<BreakEvenQuadrantData> BreakEvenQuadrants { get; set; } = [];

    // ── Computed KPIs ─────────────────────────────────────────────────────────
    private IReadOnlyList<EnterpriseComparisonRow> EnterpriseComparisonRows => BreakEvenQuadrants
        .Select(quadrant => new EnterpriseComparisonRow(
            quadrant.EnterpriseName,
            quadrant.MonthlyExpenses,
            quadrant.MonthlyRevenue,
            quadrant.MonthlyBalance,
            quadrant.BreakEvenRate))
        .ToList();

    private decimal EffectiveBreakEvenRate => ScenarioCostTotal > 0m ? AdjustedRecommendedRate : RecommendedRate;
    private decimal MonthlyRevenue => EnterpriseRateService.CalculateMonthlyRevenue(CurrentRate, ProjectedVolume);
    private decimal NetPosition => EnterpriseRateService.CalculateMonthlyBalance(MonthlyRevenue, ScenarioCostTotal > 0m ? TotalCosts + ScenarioCostTotal : TotalCosts);
    private double CoverageRatio => TotalCosts > 0 ? (double)(MonthlyRevenue / (ScenarioCostTotal > 0m ? TotalCosts + ScenarioCostTotal : TotalCosts)) : 0d;
    private double RateAdequacy => EffectiveBreakEvenRate > 0 ? (double)EnterpriseRateService.CalculateRateAdequacyPercent(CurrentRate, EffectiveBreakEvenRate) : 0d;

    // ── Waterfall ─────────────────────────────────────────────────────────────
    private IReadOnlyList<WaterfallPoint> WaterfallPoints
    {
        get
        {
            if (ScenarioItems.Count == 0) return [];
            var pts = new List<WaterfallPoint>();
            pts.Add(new WaterfallPoint("Base Cost", (double)TotalCosts));
            foreach (var item in ScenarioItems)
                pts.Add(new WaterfallPoint(item.Name, (double)item.Cost));
            pts.Add(new WaterfallPoint("With Scenario", 0d));
            return pts;
        }
    }

    private double[] WaterfallSumIndexes => [WaterfallPoints.Count - 1d];

    // ── Customer pies ─────────────────────────────────────────────────────────
    private IReadOnlyList<PiePoint> CustomersByService => Customers
        .Where(c => !string.IsNullOrWhiteSpace(c.Service))
        .GroupBy(c => c.Service)
        .Select(g => new PiePoint(g.Key, g.Count()))
        .OrderByDescending(p => p.Count)
        .ToList();

    private IReadOnlyList<PiePoint> CustomersByCityLimits => Customers
        .Where(c => !string.IsNullOrWhiteSpace(c.CityLimits))
        .GroupBy(c => c.CityLimits)
        .Select(g => new PiePoint(g.Key, g.Count()))
        .OrderByDescending(p => p.Count)
        .ToList();

    // ── Local records ─────────────────────────────────────────────────────────
    private record WaterfallPoint(string Label, double Value);
    private record PiePoint(string Label, int Count);
    private record EnterpriseComparisonRow(string EnterpriseName, decimal MonthlyCosts, decimal MonthlyRevenue, decimal NetPosition, decimal BreakEvenRate);

    // ── Overhead (global, interactive for council demo; matches AppSettings defaults from prior enhancement)
    // Sliders update live; used to compute burdened NetContribution + Holds/Vampire flags per the core formula.
    private decimal TownOverheadPercent { get; set; } = 4m;
    private decimal ManagementExpensePercent { get; set; } = 3m;
    private decimal LaborPercent { get; set; } = 2m;
    private decimal TotalOverheadPercent => TownOverheadPercent + ManagementExpensePercent + LaborPercent;

    private IReadOnlyList<EnhancedEnterpriseComparisonRow> EnhancedEnterpriseComparison =>
        EnterpriseComparisonRows.Select(r =>
        {
            var direct = r.MonthlyCosts;
            var burden = EnterpriseRateService.CalculateOverheadBurden(direct, TotalOverheadPercent);
            var net = EnterpriseRateService.CalculateNetContribution(r.MonthlyRevenue, direct, burden);
            var holds = EnterpriseRateService.HoldsItsOwn(net);
            var impact = EnterpriseRateService.CalculateVampireImpact(net);
            return new EnhancedEnterpriseComparisonRow(
                r.EnterpriseName, direct, r.MonthlyRevenue, net, r.BreakEvenRate, burden, holds, impact);
        }).ToList();

    private record EnhancedEnterpriseComparisonRow(
        string EnterpriseName,
        decimal MonthlyCosts,
        decimal MonthlyRevenue,
        decimal NetContribution,
        decimal BreakEvenRate,
        decimal OverheadBurden,
        bool HoldsItsOwn,
        decimal VampireImpact);

    private void DrillToEnterprise(string name)
    {
        // Surgical (no bloat on other files/params): logs for dev; in full shell use would update WorkspaceState.SelectedEnterprise or fire event.
        // Council user: manually pick enterprise in workspace hero or Break-Even to drill deeper (QB txns, knowledge).
        // Future: add [Parameter] EventCallback<string> OnDrill for parent wiring.
        Console.WriteLine($"[DataDashboard] Drill to {name} requested (select in shell for full context + transactions).");
    }
}
