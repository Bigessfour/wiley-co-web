{
  "dotnet.defaultSolution": "WileyCoWeb.slnx",
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true,
    "**/node_modules/**": true
  },
  "files.exclude": {
    "**/bin": true,
    "**/obj": true
  },
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/node_modules": true,
    "**/playwright-report": true,
    "**/test-results": true
  },
  "[csharp]": {
    "editor.tabSize": 4,
    "editor.formatOnSave": true
  },
  "[razor]": {
    "editor.tabSize": 4,
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.tabSize": 2
  }
}
