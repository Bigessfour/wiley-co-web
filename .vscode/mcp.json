{
  "servers": {
    "aws-knowledge-mcp": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "aws-documentation-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--from",
        "awslabs.aws-documentation-mcp-server@latest",
        "awslabs.aws-documentation-mcp-server.exe"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws"
      }
    },
    "xai-docs-mcp": {
      "type": "http",
      "url": "https://docs.x.ai/api/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["--no-install", "playwright-mcp", "--isolated"]
    },
    "sf-blazor-mcp": {
      "type": "stdio",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/Scripts/mcp-sf-blazor-assistant.sh"],
      "env": {
        "SYNCFUSION_API_KEY_PATH": "${env:HOME}/.config/syncfusion/documentsdk.key",
        "Syncfusion_API_Key_Path": "${env:HOME}/.config/syncfusion/documentsdk.key"
      }
    },
    "playwright-test": {
      "type": "stdio",
      "command": "npx",
      "args": ["playwright", "run-test-mcp-server"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222",
        "--no-usage-statistics"
      ]
    }
  }
}
