# Town of Wiley — Mac development overlay (clerk path).
# Prefer WileyCoWeb.Api/appsettings.Development.local.json + user-secrets for Widget.
# This file documents the intended shape only; do not commit secrets.

ASPNETCORE_ENVIRONMENT=Development
Database__AllowDegradedStartup=false
Database__ApplyMigrations=true
Database__SeedDevelopmentData=false

# Widget → NAS Postgres over Tailscale (not Mac Docker Postgres)
ConnectionStrings__DefaultConnection=Host=mr-storage;Port=5433;Database=wileyco_dev;Username=wiley_app;Password=REPLACE_ME;SSL Mode=Disable;Timeout=15

# Town Hub siblings (Tailscale)
# Apartments http://mr-storage:8082
# TIKR       http://mr-storage:8080
# Trash      Amplify (no NAS Postgres)
