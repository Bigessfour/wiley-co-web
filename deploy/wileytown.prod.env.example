# Town of Wiley — NAS production overlay (Synology Community PostgreSQL 17).
# Copy to a chmod-600 file on the NAS or operator machine. Never commit real passwords.
# Separate from Mac Development (appsettings.Development.local.json / user-secrets).
#
# Shared Postgres: mr-storage listens on 127.0.0.1:5433 (Tailscale publishes :5433).
# Passwords live on NAS under /root/wiley-postgres/*.pass

# --- Synology PostgreSQL (package, not Docker) ---
WILEYTOWN_PGHOST=127.0.0.1
WILEYTOWN_PGPORT=5433
WILEYTOWN_PG_SSLMODE=Disable

# --- Wiley Widget API (Office / NAS or Mac-over-Tailscale) ---
# Mac clerk path uses Host=mr-storage instead of 127.0.0.1
ASPNETCORE_ENVIRONMENT=Office
Database__AllowDegradedStartup=false
Database__ApplyMigrations=true
Database__SeedDevelopmentData=false
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5433;Database=wileyco_dev;Username=wiley_app;Password=REPLACE_FROM_wiley_app.pass;SSL Mode=Disable;Timeout=15

# --- Wiley Apartments / ClerkSuite (container uses host network) ---
ClerkSuite__DatabaseProvider=Postgres
# ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5433;Database=clerksuite;Username=clerksuite_app;Password=REPLACE_FROM_clerksuite_app.pass;SSL Mode=Disable;Timeout=15
ASPNETCORE_URLS=http://0.0.0.0:8082

# --- TIKR (Postgres; container reaches Synology PG via host.docker.internal:5433) ---
DATABASE_PROVIDER=Postgres
ConnectionStrings__Default=Host=host.docker.internal;Port=5433;Database=tikr;Username=tikr_app;Password=REPLACE_FROM_tikr_app.pass;SSL Mode=Disable;Timeout=30;Command Timeout=120
# SQLite fallback (pre-cutover backup only):
# DATABASE_PROVIDER=Sqlite
# ConnectionStrings__Default=Data Source=/data/tikr.db

# --- Isolation rules (do not merge DBs) ---
# wiley_app    -> wileyco_dev only
# clerksuite_app -> clerksuite only
# tikr_app     -> tikr only
